#!/usr/bin/env bash
# Stub for curl. Records the invocation in $CURL_LOG and answers the three
# GitHub API endpoints the hooks call.
#
# pre-command writes the body to `-o` and the headers to `-D`, and prints the
# status with `-w "%{http_code}"`. post-command's DELETE passes no `-o`, so its
# body and status both go to stdout, the way real curl does.
#
# STUB_INSTALLATION_HTTP_CODE and STUB_ACCESS_TOKEN_HTTP_CODE are space-separated
# lists: the nth request to an endpoint gets the nth entry, and the last entry
# repeats. An `exit:N` entry fails like a transport error, with curl exit code N;
# `exit:N:CODE` sends status CODE and part of its body before failing that way.
# STUB_ERROR_MESSAGE sets the message of every error body.
set -uo pipefail

printf '%s\n' "$*" >> "$CURL_LOG"

# curl is always invoked with the URL as the final argument.
url="${!#}"

body_file=/dev/stdout
header_file=/dev/null
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) body_file="$2"; shift ;;
    -D) header_file="$2"; shift ;;
  esac
  shift
done

# The entry of a code list that answers this request.
pick_code() {
  local -a codes
  local calls
  read -ra codes <<< "$1"
  calls=$(grep -cF -- "$url" "$CURL_LOG")
  (( calls > ${#codes[@]} )) && calls=${#codes[@]}
  echo "${codes[calls - 1]}"
}

respond() {
  local http_code="$1" body="$2"

  if [[ "$http_code" == exit:* ]]; then
    local curl_exit status
    IFS=: read -r _ curl_exit status <<< "$http_code"
    if [[ -n "$status" ]]; then
      printf 'HTTP/2 %s\r\n\r\n' "$status" > "$header_file"
      printf '%s' "${body:0:20}" > "$body_file"
    fi
    printf '%s' "${status:-000}"
    exit "$curl_exit"
  fi

  {
    printf 'HTTP/2 %s\r\n' "$http_code"
    if [[ "$http_code" != 2?? && -n "${STUB_RETRY_AFTER:-}" ]]; then
      printf 'retry-after: %s\r\n' "$STUB_RETRY_AFTER"
    fi
    if [[ "$http_code" != 2?? && -n "${STUB_RATELIMIT_RESET:-}" ]]; then
      printf 'x-ratelimit-remaining: 0\r\nx-ratelimit-reset: %s\r\n' "$STUB_RATELIMIT_RESET"
    fi
    printf '\r\n'
  } > "$header_file"
  printf '%s' "$body" > "$body_file"
  printf '%s' "$http_code"
}

error_body="{\"message\":\"${STUB_ERROR_MESSAGE:-stubbed failure}\"}"

case "$url" in
  */installation/token)
    # DELETE — token revocation. 204 is success; no body.
    printf '%s' "${STUB_REVOKE_HTTP_CODE:-204}"
    ;;
  */installation)
    # GET — installation lookup for the repository.
    http_code=$(pick_code "${STUB_INSTALLATION_HTTP_CODE:-200}")
    if [[ "$http_code" == "200" ]]; then
      respond "$http_code" "{\"id\":${STUB_INSTALLATION_ID:-87654321}}"
    else
      respond "$http_code" "$error_body"
    fi
    ;;
  */access_tokens)
    # POST — mint an installation access token.
    http_code=$(pick_code "${STUB_ACCESS_TOKEN_HTTP_CODE:-201}")
    if [[ "${http_code#exit:*:}" != 2?? || "${STUB_ACCESS_TOKEN:-}" == "" ]]; then
      respond "$http_code" "$error_body"
    else
      respond "$http_code" "{\"token\":\"${STUB_ACCESS_TOKEN}\",\"expires_at\":\"2099-01-01T00:00:00Z\"}"
    fi
    ;;
  *)
    echo "curl stub: unexpected URL: $url" >&2
    exit 22
    ;;
esac
