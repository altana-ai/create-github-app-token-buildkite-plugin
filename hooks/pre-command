#!/bin/bash
set -euo pipefail

echo "--- :github: Creating GitHub App Token"

# Hook state is namespaced and cleared first, so a same-named exported variable cannot carry it into the job
_cgat_state=(_cgat_jwt _cgat_jwt_refresh_at _cgat_status _cgat_body _cgat_failure _cgat_installation_id
  _cgat_access_token _cgat_max_attempts _cgat_max_retry_wait _cgat_connect_timeout _cgat_max_time
  _cgat_transient_curl_exits)
unset "${_cgat_state[@]}"

PLUGIN_PREFIX="CREATE_GITHUB_APP_TOKEN"
PERMISSION_PREFIX="BUILDKITE_PLUGIN_${PLUGIN_PREFIX}_PERMISSION_"

# Plugin configuration reader function
function plugin_read_config() {
  local +x var="BUILDKITE_PLUGIN_${PLUGIN_PREFIX}_${1}"
  local +x default="${2:-}"
  local +x value="${!var:-$default}"

  # Handle environment variable expansion for values starting with $
  if [[ "$value" =~ ^\$([A-Za-z_][A-Za-z0-9_]*) ]]; then
    local +x env_var="${BASH_REMATCH[1]}"
    echo "${!env_var}"
  else
    echo "$value"
  fi
}

# Get plugin configuration
app_id=$(plugin_read_config "APP_ID")
private_key=$(plugin_read_config "PRIVATE_KEY")
owner=$(plugin_read_config "OWNER")
repositories=$(plugin_read_config "REPOSITORIES")
skip_token_revoke=$(plugin_read_config "SKIP_TOKEN_REVOKE" "false")
github_api_url=$(plugin_read_config "GITHUB_API_URL" "https://api.github.com")
output_variable=$(plugin_read_config "OUTPUT_VARIABLE" "GITHUB_TOKEN")
_cgat_max_attempts=$(plugin_read_config "MAX_ATTEMPTS" "5")
_cgat_max_retry_wait=$(plugin_read_config "MAX_RETRY_WAIT" "120")

# Per-request curl timeouts, in seconds
_cgat_connect_timeout=10
_cgat_max_time=30

# Clean null bytes and other problematic characters from private key
private_key=$(echo "$private_key" | tr -d '\0' | tr -d '\r')

# Validate required inputs
if [[ -z "$app_id" ]]; then
  echo "❌ Error: app-id is required" >&2
  exit 1
fi

if [[ -z "$private_key" ]]; then
  echo "❌ Error: private-key is required" >&2
  exit 1
fi

# Check if jq is available
if ! command -v jq &> /dev/null; then
  echo "❌ Error: jq is required but not installed" >&2
  echo "Please install jq to use this plugin" >&2
  exit 1
fi

if [[ ! "$_cgat_max_attempts" =~ ^[1-9][0-9]*$ ]]; then
  echo "❌ Error: max-attempts must be a positive integer, got '$_cgat_max_attempts'" >&2
  exit 1
fi

if [[ ! "$_cgat_max_retry_wait" =~ ^(0|[1-9][0-9]*)$ ]]; then
  echo "❌ Error: max-retry-wait must be a non-negative integer, got '$_cgat_max_retry_wait'" >&2
  exit 1
fi

# Function to generate JWT token
generate_jwt() {
  local +x app_id="$1"
  local +x private_key="$2"

  # Validate private key format
  if [[ -z "$private_key" ]]; then
    echo "❌ Error: Private key is empty" >&2
    exit 1
  fi

  if [[ ! "$private_key" =~ -----BEGIN ]]; then
    echo "❌ Error: Private key does not appear to be in PEM format (missing -----BEGIN)" >&2
    exit 1
  fi

  # Create temporary file for private key
  local +x temp_key_file
  temp_key_file=$(mktemp)

  # Write private key to temp file and clean null bytes
  echo "$private_key" | tr -d '\0' | tr -d '\r' > "$temp_key_file"

  # Test if OpenSSL can read the private key
  if ! openssl rsa -in "$temp_key_file" -check -noout >/dev/null 2>&1; then
    echo "❌ Error: Invalid private key format or content" >&2
    rm "$temp_key_file"
    exit 1
  fi

  # Generate JWT payload
  local +x now
  now=$(date +%s)
  local +x exp=$((now + 600))  # 10 minutes expiration

  # Create header and payload
  local +x header='{"alg":"RS256","typ":"JWT"}'
  local +x payload="{\"iat\":$now,\"exp\":$exp,\"iss\":\"$app_id\"}"

  # Base64 encode header and payload
  local +x encoded_header
  encoded_header=$(echo -n "$header" | base64 | tr -d '=' | tr '/+' '_-' | tr -d '\n')
  local +x encoded_payload
  encoded_payload=$(echo -n "$payload" | base64 | tr -d '=' | tr '/+' '_-' | tr -d '\n')

  # Create signature
  local +x signature_input="${encoded_header}.${encoded_payload}"
  local +x signature temp_sign_output_file

  # Use temporary file for OpenSSL output to avoid null byte issues
  temp_sign_output_file=$(mktemp)
  echo -n "$signature_input" | openssl dgst -sha256 -sign "$temp_key_file" > "$temp_sign_output_file" 2>/dev/null
  local +x sign_exit_code=$?

  if [[ $sign_exit_code -ne 0 ]]; then
    echo "❌ Error: Failed to sign JWT token" >&2
    rm "$temp_key_file" "$temp_sign_output_file"
    exit 1
  fi

  # Base64 encode directly from file to avoid null bytes in variables
  signature=$(base64 < "$temp_sign_output_file" | tr -d '=' | tr '/+' '_-' | tr -d '\n')

  # Clean up temporary files
  rm "$temp_key_file" "$temp_sign_output_file"

  # Return JWT
  echo "${encoded_header}.${encoded_payload}.${signature}"
}

# Function to get repository owner and name
get_repo_info() {
  local +x repo_owner repo_name

  # Use provided owner or extract from BUILDKITE_REPO
  if [[ -n "$owner" ]]; then
    repo_owner="$owner"
    # When owner is specified, we need to determine repo name
    if [[ -n "${BUILDKITE_REPO:-}" ]]; then
      if [[ "$BUILDKITE_REPO" =~ git@github\.com:(.+)/(.+)\.git ]]; then
        repo_name="${BASH_REMATCH[2]}"
      elif [[ "$BUILDKITE_REPO" =~ https://github\.com/(.+)/(.+)\.git ]]; then
        repo_name="${BASH_REMATCH[2]}"
      else
        echo "❌ Error: Unable to parse repository name from BUILDKITE_REPO: $BUILDKITE_REPO" >&2
        exit 1
      fi
    else
      echo "❌ Error: BUILDKITE_REPO environment variable not set" >&2
      exit 1
    fi
  else
    # Auto-detect owner and repo from BUILDKITE_REPO
    if [[ -n "${BUILDKITE_REPO:-}" ]]; then
      if [[ "$BUILDKITE_REPO" =~ git@github\.com:(.+)/(.+)\.git ]]; then
        repo_owner="${BASH_REMATCH[1]}"
        repo_name="${BASH_REMATCH[2]}"
      elif [[ "$BUILDKITE_REPO" =~ https://github\.com/(.+)/(.+)\.git ]]; then
        repo_owner="${BASH_REMATCH[1]}"
        repo_name="${BASH_REMATCH[2]}"
      else
        echo "❌ Error: Unable to parse repository from BUILDKITE_REPO: $BUILDKITE_REPO" >&2
        exit 1
      fi
    else
      echo "❌ Error: BUILDKITE_REPO environment variable not set" >&2
      exit 1
    fi
  fi

  echo "$repo_owner $repo_name"
}

# curl exits worth retrying: DNS, connect, HTTP/2, partial transfer, timeout, TLS handshake, dropped connection
_cgat_transient_curl_exits=" 5 6 7 16 18 28 35 52 55 56 92 "

# Function to read a response header, case-insensitively, from a `curl -D` dump
header_value() {
  awk -v name="$2" 'tolower($1) == name ":" { value = $2 } END { print value }' <<< "$1" | tr -d '\r'
}

# Function to show a failed response's body in the log, with anything token-shaped masked
loggable_body() {
  if [[ -z "$1" ]]; then
    echo "<empty>"
    return
  fi
  sed -E 's/"token"[[:space:]]*:[[:space:]]*"[^"]*"/"token":"[REDACTED]"/g; s/(gh[opsur]|github_pat)_[A-Za-z0-9_]+/[REDACTED]/g' <<< "$1"
}

# Function to sign a JWT unless the current one outlives a whole request with retries
ensure_jwt() {
  local +x now
  now=$(date +%s)
  if [[ -n "${_cgat_jwt:-}" && "$now" -lt "${_cgat_jwt_refresh_at:-0}" ]]; then
    return 0
  fi

  _cgat_jwt=$(generate_jwt "$app_id" "$private_key") || exit 1
  # generate_jwt sets a 600s expiry; renewing 120s early keeps every attempt inside it
  _cgat_jwt_refresh_at=$(( now + 480 ))
}

# Function to name the rate limit a failed response hit, or print nothing
rate_limit_kind() {
  local +x http_code="$1" retry_after="$2" remaining="$3" body="$4"
  [[ "$http_code" == 403 || "$http_code" == 429 ]] || return 0

  if [[ "$body" == *[Ss]"econdary rate limit"* || "$body" == *"abuse detection"* ]]; then
    echo "secondary rate limit"
  elif [[ "$http_code" == 429 || "$remaining" == 0 || -n "$retry_after" ]]; then
    echo "rate limit"
  fi
}

# Function to tell a transient API failure from a permanent one
is_transient() {
  local +x curl_exit="$1" http_code="$2" rate_limit="$3"

  # With no status to go on, the curl exit decides
  if [[ "$http_code" == 000 ]]; then
    [[ "$_cgat_transient_curl_exits" == *" $curl_exit "* ]]
    return
  fi
  [[ -n "$rate_limit" || "$http_code" == 5?? ]]
}

# Function to pick the wait before the next attempt, or print nothing when it would pass the budget
#
# The wait is the server's hint, GitHub's rate-limit minute (doubled for each
# consecutive rate limit) or exponential backoff, and never shorter than the
# backoff step. Jitter is added on top but never takes the total past
# max-retry-wait.
retry_delay() {
  local +x attempt="$1" retry_after="$2" remaining="$3" reset="$4" rate_limit="$5" streak="$6" waited="$7"
  local +x backoff base span delay

  backoff=$(( 2 ** (attempt < 4 ? attempt : 4) ))
  if [[ "$retry_after" =~ ^[0-9]+$ ]]; then
    base=$(( 10#$retry_after ))
  elif [[ -n "$rate_limit" && "$remaining" == 0 && "$reset" =~ ^[0-9]+$ ]]; then
    base=$(( 10#$reset - $(date +%s) ))
  elif [[ -n "$rate_limit" ]]; then
    # GitHub asks for at least a minute when a rate limit gives no hint
    base=$(( 60 * 2 ** (streak - 1) ))
  else
    # Up to 100% jitter, capped at 30s: 2-3s, 4-7s, 8-15s, then 16-30s
    base=$backoff
    span=$(( backoff - 1 < 30 - backoff ? backoff - 1 : 30 - backoff ))
  fi
  if (( base < backoff )); then
    base=$backoff
  fi
  # Up to 25%, at least 1s, so parallel jobs given the same wait do not retry in lockstep
  span=${span:-$(( base / 4 > 1 ? base / 4 : 1 ))}

  if (( waited + base > _cgat_max_retry_wait )); then
    return 0
  fi
  delay=$(( base + RANDOM % (span + 1) ))
  echo $(( waited + delay > _cgat_max_retry_wait ? _cgat_max_retry_wait - waited : delay ))
}

# Function to call the GitHub API, retrying transient failures
#
# Sets _cgat_status to the three-digit HTTP status (000 when no usable status
# arrived), _cgat_body to the response body (empty after a transport error), and
# _cgat_failure to what went wrong on the last attempt.
github_api_request() {
  local +x method="$1" url="$2" body="${3:-}"
  local +x -a body_args=()
  if [[ -n "$body" ]]; then
    body_args=(-H "Content-Type: application/json" -d "$body")
  fi

  local +x attempt=1 waited=0 streak=0 header_file headers output curl_exit delay rate_limit shown_body
  local +x retry_after remaining reset
  while true; do
    ensure_jwt

    # Only the headers touch the disk; the body, which may hold the token, stays in memory
    header_file=$(mktemp)
    curl_exit=0
    output=$(curl -sS -X "$method" -D "$header_file" -w "%{http_code}" \
      --connect-timeout "$_cgat_connect_timeout" --max-time "$_cgat_max_time" \
      -H "Authorization: Bearer $_cgat_jwt" \
      -H "Accept: application/vnd.github.v3+json" \
      ${body_args[@]+"${body_args[@]}"} \
      "$url") || curl_exit=$?
    headers=$(cat "$header_file")
    rm -f "$header_file"
    _cgat_status="${output: -3}"
    _cgat_body="${output%???}"
    if [[ ! "$_cgat_status" =~ ^[0-9]{3}$ ]]; then
      _cgat_status="000"
    fi

    if [[ "$curl_exit" -eq 0 && "$_cgat_status" == 2?? ]]; then
      _cgat_failure=""
      break
    fi

    _cgat_failure="HTTP $_cgat_status"
    if [[ "$curl_exit" -ne 0 ]]; then
      _cgat_failure="curl exit $curl_exit"
      if [[ "$_cgat_status" != 000 ]]; then
        _cgat_failure+=" after HTTP $_cgat_status"
      fi
      # A 2xx cut off mid-transfer says nothing, but an error status that arrived still counts
      if [[ "$_cgat_status" == 2?? ]]; then
        _cgat_status="000"
      fi
    fi

    retry_after=$(header_value "$headers" "retry-after")
    remaining=$(header_value "$headers" "x-ratelimit-remaining")
    reset=$(header_value "$headers" "x-ratelimit-reset")
    rate_limit=$(rate_limit_kind "$_cgat_status" "$retry_after" "$remaining" "$_cgat_body")
    if [[ -n "$rate_limit" ]]; then
      _cgat_failure+=", $rate_limit"
    fi
    if [[ "$curl_exit" -ne 0 ]]; then
      # A body cut off mid-transfer may hold a minted token, so it is dropped unread
      _cgat_body=""
    fi

    if ! is_transient "$curl_exit" "$_cgat_status" "$rate_limit"; then
      break
    fi

    if [[ "$attempt" -ge "$_cgat_max_attempts" ]]; then
      echo "❌ Error: $method $url still failing after $attempt attempts ($_cgat_failure)" >&2
      break
    fi

    if [[ -n "$rate_limit" ]]; then
      streak=$(( streak + 1 ))
    else
      streak=0
    fi
    delay=$(retry_delay "$attempt" "$retry_after" "$remaining" "$reset" "$rate_limit" "$streak" "$waited")
    if [[ -z "$delay" ]]; then
      echo "❌ Error: $method $url still failing ($_cgat_failure); its next wait would exceed max-retry-wait (${_cgat_max_retry_wait}s)" >&2
      break
    fi

    shown_body="not logged after a transport error"
    if [[ "$curl_exit" -eq 0 ]]; then
      shown_body=$(loggable_body "$_cgat_body")
    fi
    echo "⚠️ Attempt $attempt/$_cgat_max_attempts: $method $url failed ($_cgat_failure). Response: $shown_body" >&2
    echo "⏳ Retrying in ${delay}s..." >&2
    sleep "$delay"
    waited=$(( waited + delay ))
    attempt=$(( attempt + 1 ))
  done
}

# Function to fail the step on an API call that did not succeed, logging its body once
fail_api_call() {
  echo "❌ Error: $1 ($_cgat_failure)" >&2
  if [[ "$_cgat_failure" != curl* ]]; then
    echo "Response: $(loggable_body "$_cgat_body")" >&2
  fi
  exit 1
}

# Function to look up the installation ID, into _cgat_installation_id
get_installation_id() {
  local +x repo_owner="$1"
  local +x repo_name="$2"

  # Get installation ID for the repository
  github_api_request GET "${github_api_url}/repos/${repo_owner}/${repo_name}/installation"

  # Check for 404 - App not installed
  if [[ "$_cgat_status" == "404" ]]; then
    echo "❌ Error: GitHub App is not installed on ${repo_owner}/${repo_name}" >&2
    echo "Please install the GitHub App on this repository or organization:" >&2
    echo "1. Go to your GitHub App settings" >&2
    echo "2. Click 'Install App' in the left sidebar" >&2
    echo "3. Select the organization/account: ${repo_owner}" >&2
    echo "4. Choose to install on selected repositories or all repositories" >&2
    exit 1
  fi

  # Check for other HTTP errors
  if [[ "$_cgat_status" != 2?? ]]; then
    fail_api_call "Failed to get installation information"
  fi

  # Extract installation ID from response using jq; a body that is not JSON has none
  _cgat_installation_id=$(jq -r '.id // empty' <<< "$_cgat_body" 2>/dev/null) || _cgat_installation_id=""

  if [[ -z "$_cgat_installation_id" ]]; then
    echo "❌ Error: Failed to extract installation ID from response" >&2
    echo "Response: $(loggable_body "$_cgat_body")" >&2
    exit 1
  fi
}

# Function to build permissions JSON
#
# Every `permission-*` option is passed through to the API, rather than a
# hardcoded subset: GitHub adds app permissions regularly, and
# actions/create-github-app-token generates its own list from GitHub's OpenAPI
# description. `permission-<name>` becomes the API permission `<name>` with
# dashes replaced by underscores, which is the same rule the action applies.
#
# Emits the permissions object, or `{}` when none were configured — in which case
# the token inherits every permission the app installation has.
build_permissions_json() {
  local +x -a args=()
  local +x var key value

  while IFS= read -r var; do
    value="${!var}"
    [[ -n "$value" ]] || continue

    key=$(permission_api_key "${var#"${PERMISSION_PREFIX}"}")
    args+=(--arg "$key" "$value")
  done < <(compgen -e | grep "^${PERMISSION_PREFIX}" | sort)

  if [[ ${#args[@]} -eq 0 ]]; then
    echo '{}'
    return
  fi

  # jq assembles the object so a permission name or value can never break the
  # JSON, whatever GitHub names things next.
  jq -nc '$ARGS.named' "${args[@]}"
}

# Function to map a plugin option suffix to an API permission name
#
# Buildkite upper-cases and underscores option names, so PULL_REQUESTS is
# `permission-pull-requests` is the API's `pull_requests`.
permission_api_key() {
  local +x key
  key=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')

  # This plugin shipped `permission-organization-members` before adopting the
  # action's naming; the API permission has always been `members`.
  if [[ "$key" == "organization_members" ]]; then
    echo "⚠️  permission-organization-members is deprecated, use permission-members" >&2
    key="members"
  fi

  echo "$key"
}

# Function to build repositories array
#
# Accepts the comma-separated and the newline-separated (YAML block scalar) forms
# the README documents, and emits a JSON array, or `null` for "every repository
# the installation can see".
build_repositories_json() {
  local +x -a repos=()
  local +x repo

  # `read -ra` would stop at the first newline however IFS is set, so the two
  # separators are normalised to one and the input is read line by line.
  while IFS= read -r repo; do
    # Trim surrounding whitespace.
    repo="${repo#"${repo%%[![:space:]]*}"}"
    repo="${repo%"${repo##*[![:space:]]}"}"
    [[ -n "$repo" ]] && repos+=("$repo")
  done < <(printf '%s\n' "$repositories" | tr ',' '\n')

  if [[ ${#repos[@]} -eq 0 ]]; then
    echo "null"
    return
  fi

  jq -nc '$ARGS.positional' --args "${repos[@]}"
}

# Function to generate installation access token, into _cgat_access_token
generate_installation_token() {
  local +x installation_id="$1"

  # Build request body. Both keys are omitted when not configured: an absent
  # `permissions` inherits the installation's permissions, and an absent
  # `repositories` grants access to all of them.
  local +x permissions_json repositories_json request_body
  permissions_json=$(build_permissions_json)
  repositories_json=$(build_repositories_json)

  request_body=$(jq -nc \
    --argjson permissions "$permissions_json" \
    --argjson repositories "$repositories_json" \
    '{}
     | if ($permissions | length) > 0 then .permissions = $permissions else . end
     | if $repositories != null then .repositories = $repositories else . end')

  # Log the token request payload
  echo "📋 Token request payload: $request_body" >&2

  # Extract and log just the permissions for easier reading
  local +x permissions_summary
  permissions_summary=$(echo "$request_body" | jq -r '.permissions // {} | to_entries | map("\(.key): \(.value)") | join(", ")')
  if [[ -n "$permissions_summary" && "$permissions_summary" != "" ]]; then
    echo "🔐 Requested permissions: $permissions_summary" >&2
  fi

  # Log repositories if specified
  local +x repositories_summary
  repositories_summary=$(echo "$request_body" | jq -r '.repositories // null | if . == null then "all accessible" else join(", ") end')
  echo "📁 Target repositories: $repositories_summary" >&2

  # Generate installation access token
  github_api_request POST "${github_api_url}/app/installations/${installation_id}/access_tokens" "$request_body"

  if [[ "$_cgat_status" != 2?? ]]; then
    fail_api_call "Failed to generate installation token"
  fi

  # Extract token from response using jq; a body that is not JSON has none
  _cgat_access_token=$(jq -r '.token // empty' <<< "$_cgat_body" 2>/dev/null) || _cgat_access_token=""

  if [[ -z "$_cgat_access_token" ]]; then
    _cgat_failure="HTTP $_cgat_status without a token"
    fail_api_call "Failed to generate installation token"
  fi

  # Register the token with the redactor before anything else can log it
  echo "$_cgat_access_token" | buildkite-agent redactor add
  unset _cgat_body
}

# Main execution
# Signing up front makes a bad private key fail before any request
echo "🔑 Generating JWT token..."
ensure_jwt

echo "🔍 Getting repository information..."
repo_info=$(get_repo_info)
read -r repo_owner repo_name <<< "$repo_info"
echo "Repository: $repo_owner/$repo_name"

echo "🔍 Getting installation ID..."
get_installation_id "$repo_owner" "$repo_name"

# Export installation ID as environment variable
export GITHUB_APP_INSTALLATION_ID="$_cgat_installation_id"
echo "✅ GitHub App installation ID exported as GITHUB_APP_INSTALLATION_ID: $_cgat_installation_id"

echo "🎫 Generating installation access token..."
generate_installation_token "$_cgat_installation_id"

# Export token as environment variable
export "$output_variable"="$_cgat_access_token"
echo "✅ GitHub App token generated and exported as $output_variable"

# Store token information for post-command cleanup if revocation is enabled.
# These must be exported: buildkite-agent propagates only exported variables
# between hooks, so a plain assignment leaves post-command with nothing to revoke.
if [[ "$skip_token_revoke" == "false" ]]; then
  export GITHUB_APP_TOKEN_FOR_REVOCATION="$_cgat_access_token"
  export GITHUB_API_URL_FOR_REVOCATION="$github_api_url"
fi

unset "${_cgat_state[@]}" _cgat_state
