#!/bin/bash
set -euo pipefail

echo "--- :github: GitHub App Token Cleanup"

PLUGIN_PREFIX="CREATE_GITHUB_APP_TOKEN"

# Plugin configuration reader function
function plugin_read_config() {
  local var="BUILDKITE_PLUGIN_${PLUGIN_PREFIX}_${1}"
  local default="${2:-}"
  local value="${!var:-$default}"

  # Handle environment variable expansion for values starting with $
  if [[ "$value" =~ ^\$([A-Za-z_][A-Za-z0-9_]*) ]]; then
    local env_var="${BASH_REMATCH[1]}"
    echo "${!env_var}"
  else
    echo "$value"
  fi
}

output_variable=$(plugin_read_config "OUTPUT_VARIABLE" "GITHUB_TOKEN")
skip_token_revoke=$(plugin_read_config "SKIP_TOKEN_REVOKE" "false")

# Function to revoke token
revoke_token() {
  local token="$1"
  local api_url="$2"

  echo "🔐 Revoking GitHub App token..."

  # Make DELETE request to revoke the token
  local response
  response=$(curl -s -w "%{http_code}" -X DELETE --connect-timeout 10 --max-time 30 \
    -H "Authorization: token $token" \
    -H "Accept: application/vnd.github.v3+json" \
    "${api_url}/installation/token" 2>/dev/null || echo "000")

  local http_code="${response: -3}"

  if [[ "$http_code" == "204" ]]; then
    echo "✅ Token revoked successfully"
  else
    echo "⚠️ Warning: Token revocation failed (HTTP $http_code). Token may still be active."
  fi
}

# Handle token revocation
if [[ "$skip_token_revoke" == "true" ]]; then
  echo "ℹ️ Token revocation disabled (skip-token-revoke=true)"
elif [[ -n "${GITHUB_APP_TOKEN_FOR_REVOCATION:-}" ]]; then
  revoke_token "$GITHUB_APP_TOKEN_FOR_REVOCATION" "${GITHUB_API_URL_FOR_REVOCATION:-https://api.github.com}"
  # Clear the token from memory
  unset GITHUB_APP_TOKEN_FOR_REVOCATION GITHUB_API_URL_FOR_REVOCATION
else
  # Revocation is enabled (skip-token-revoke is not "true") yet pre-command left no
  # token behind, so nothing can be revoked and the token stays valid until it expires.
  echo "⚠️ Warning: token revocation is enabled but no token was found to revoke."
  echo "   Any token minted for this step remains valid until it expires (up to 1 hour)."
  echo "   This means the pre-command hook did not run, or failed before minting a token."
fi

# Clean up token from environment
if [[ -n "${!output_variable:-}" ]]; then
  echo "🧹 Cleaning up GitHub App token from environment variable $output_variable"
  unset "$output_variable"
  # Verify cleanup was successful
  if [[ -z "${!output_variable:-}" ]]; then
    echo "✅ Environment variable $output_variable successfully cleared"
  else
    echo "⚠️ Warning: Failed to clear environment variable $output_variable"
  fi
else
  echo "ℹ️ Environment variable $output_variable is not set (nothing to clean up)"
fi
